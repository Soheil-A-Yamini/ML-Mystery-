"""
Define a class for a VAE: variational autoencoder with 3 main blocks: encoder -> bottleneck -> decoder.
Encoder: receives an input, e.g. an img., throght its layer, e.g. dense or Conv., it compresses data representation, then pass to Bottleneck: e.g. it can be 2 or 5 neurons/variables. But
some of the data are lost because of small representation of input especially in Bottleneck layer. Thus, by increasing number of Buttleneck, the information lost is reduced.

Decoder: in its layer we are trying to reconstruct the input, for example by dense or Conv. layers. 

Learning: To able the network to learn, we need to push gradient to every layers, every neurons, howevre, in the sampling nodes, e.g. Bottlenck it is not possible to push gradient. 
So, we utilize a smart technique called as reparametrization trick. In the Bottleneck we are sampling from a distribution called 'Z', and Z is not gradient able, thus, 
before sampleing node, we add another 2 vectors: mean-> mu: is mean of the distribution, and std-> sigma: is standard deviation of the distribution, and sampling from a epsilon with a 
normal dist., epsilon ~N(0, 1), then pass to sampling node. Therefore, now we can push gradient to whole network.

Loss: consist of 2 losses: 1- Reconstructed loss: expectation of distrbuiton , 2- KL-divergence: it calculates how much two distributions differes form each other. 
KL-div., ensures the sampling is with the same dist., not too fare from. 
"""

class VAE(nn.Module):
    def __init__(self, input_dim=500, hidden_dim1=300, hidden_dim2=10, latent_dim=2): # is it correct to reduce nerons dramatically? Yes.
        super(VAE, self).__init__() # initialize parent class nn.Module to ensure internall machinery.

        # Encoder
        self.encoder_fc1 = nn.Linear(in_features=input_dim, out_features=hidden_dim1) # fc: fully connected 
        self.encoder_fc2 = nn.Linear(hidden_dim1, hidden_dim2)

        # Latent space
        self.fc_mu = nn.Linear(hidden_dim2, latent_dim)
        self.fc_logvar = nn.Linear(hidden_dim2, latent_dim) # network output usually is log(σ²)

        # Decoder
        self.decoder_fc1 = nn.Linear(latent_dim, hidden_dim2)
        self.decoder_fc2 = nn.Linear(hidden_dim2, hidden_dim1)
        self.decoder_fc3 = nn.Linear(hidden_dim1, input_dim)

        self.relu = nn.ReLU()

    def encoder(self, x):
        x = self.relu(self.encoder_fc2(self.encoder_fc1(x))) #logic: execustion starts from the most inner part, here x.
        mu = self.fc_mu(x)
        logvar = self.fc_logvar(x)
        return mu, logvar
    
    def reparametrize(self, mu, logvar): 
        """z = mu + epsilon * std, s.t. eps ~ N(0,1)"""
        std = torch.exp(0.5 * logvar)
        epsilon = torch.randn_like(std) # randn: standard normal eps ~ N(0, 1)
        return mu + epsilon * std # z ~ N(mu, sigma^2)
    
    def decoder(self, z):
        z = self.relu(self.decoder_fc2(self.decoder_fc1(z)))
        return torch.sigmoid(self.decoder_fc3(z)) # Utilize sigmoid to bound output ~[0,1]

    def forward(self, x):
        """Feed-forward of the network"""
        mu, sigma = self.encoder(x) # block1 ->Encoder: compress Input
        z = self.reparametrize(mu, sigma) # block2 ->Botteleneck
        reconstructed_x = self.decoder(z) # block3 ->Decoder: Input Reconstruction 
        return mu, sigma, reconstructed_x


if __name__ == '__main__':
    x = torch.randn(4, 28*28) # batch_size, h by w
